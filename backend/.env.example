# =============================================================================
# REKBER Backend - Environment Configuration Example
# =============================================================================
# Duplicate this file to .env and configure the values appropriately.
# NEVER commit .env files containing real secrets to version control.

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rekber?schema=public

# Test Database Configuration (Must end with _test)
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/rekber_test?schema=public

# Authentication (JWT)
# Minimum 32 characters required for security
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
JWT_EXPIRES_IN=15m

# Security
BCRYPT_SALT_ROUNDS=12
TRUST_PROXY=false
DATA_ENCRYPTION_KEY=replace_with_a_secure_random_key_at_least_32_characters_long

# Logging (trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# CORS Configuration (Comma-separated in production)
# Example: http://localhost:3000,https://app.rekber.id
CORS_ORIGIN=http://localhost:3000

# Rate Limiting (express-rate-limit)
RATE_LIMIT_GLOBAL_WINDOW_MS=900000
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MS=3600000
RATE_LIMIT_REGISTER_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=3600000
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_REFRESH_WINDOW_MS=900000
RATE_LIMIT_REFRESH_MAX=60

# Mail Configuration (SMTP via nodemailer)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=smtp-user@example.com
SMTP_PASS=smtp-password-placeholder
SMTP_FROM="Rekber <no-reply@rekber.id>"

# Payment Gateway Configuration (Xendit / Fake)
PAYMENT_PROVIDER=fake
XENDIT_SECRET_KEY=xnd_development_placeholder_secret_key
XENDIT_WEBHOOK_VERIFICATION_TOKEN=placeholder_xendit_callback_token

# Storage Configuration (local / s3)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=storage_uploads
STORAGE_LOCAL_SECRET=replace_with_a_secure_hmac_secret_for_local_signed_urls
S3_BUCKET=rekber-assets
S3_REGION=ap-southeast-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=placeholder_access_key
S3_SECRET_ACCESS_KEY=placeholder_secret_key
S3_FORCE_PATH_STYLE=false


